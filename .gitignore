# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Node / frontend
node_modules/
web/dist/
web/coverage/
*.tsbuildinfo

# DevRepro local state
.devrepro-history/
*.devrepro-snapshot.json

# Docs site build output
site/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Env / secrets (never commit)
.env
.env.*
*.pem
*.key

# Local scan output used by the dev server; never committed.
web/public/report.json

# Playwright
web/test-results/
# Visual-regression baselines are per-platform: a screenshot taken on Windows
# differs from one taken on Linux in font rasterisation alone. Committing one
# platform's would fail every CI run on another and teach everybody to ignore
# the suite. Generate them on the platform that will compare them --
#   npx playwright test e2e/visual.spec.ts --update-snapshots
# -- and commit them from there if you want the check enforced.
web/e2e/*.spec.ts-snapshots/
web/playwright-report/
web/blob-report/
web/.playwright/
